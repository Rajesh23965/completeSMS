<!-- views/partials/subheader.ejs -->
<header class="subheader">
  <div class="subheader-left">
    <% if (typeof icon !=='undefined' && icon) { %>
      <a href="http://localhost:3000/" class="page-title-icon">
        <i class="fas <%= icon %>"></i>
      </a>
      <% } %>

        <h2 class="subheader-title">
          <%= title || 'Dashboard' %>
        </h2>
  </div>
</header>