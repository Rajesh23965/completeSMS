<header class="panel-heading">
    <h4 class="panel-title"><i class="far fa-user-circle"></i>Add Employee</h4>
</header>

<div class="main-form">
    <form action="/employee/add" method="POST" enctype="multipart/form-data" id="employeeForm">
        <!-- Academic Details -->
        <div class="form-section">
            <div class="section-header">
                <i class="fas fa-school"></i>
                Academic Details
            </div>

            <div class="row">
                <div class="col-half">
                    <label class="required-field">Role</label>
                    <select name="role" class="simple-input select2" required>
                        <option value="">Select Role</option>
                        <% roles.forEach(role=> { %>
                            <option value="<%= role %>">
                                <%= role %>
                            </option>
                            <% }) %>
                    </select>
                </div>



                <div class="col-half">
                    <label class="required-field">Joining Date</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-calendar-alt"></i></span>
                        <input type="text" name="joining_date" class="form-control flatpickr-date"
                            placeholder="Select Date" required>
                    </div>

                </div>
            </div>

            <div class="row">
                <div class="col-half">
                    <label class="required-field">Designation</label>
                    <select name="designation_id" class="simple-input select2" required>
                        <option value="">Select Designation</option>
                        <% designations.forEach(d=> { %>
                            <option value="<%= d.id %>">
                                <%= d.designation_name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="col-half">
                    <label class="required-field">Department</label>
                    <select name="department_id" class="simple-input select2" required>
                        <option value="">Select Department</option>
                        <% departments.forEach(dep=> { %>
                            <option value="<%= dep.id %>">
                                <%= dep.department_name %>
                            </option>
                            <% }) %>
                    </select>
                </div>
            </div>


            <!-- Qualification and Experience -->
            <div class="row">
                <div class="col-third">
                    <label>Qualification <span class="required">*</span></label>
                    <input type="text" name="qualification" required class="simple-input">
                </div>
                <div class="col-third">
                    <label>Experience Details</label>
                    <input type="text" name="experience_details" class="simple-input">
                </div>
                <div class="col-third">
                    <label>Total Experience</label>
                    <input type="number" name="total_experience" class="simple-input">

                </div>

            </div>


        </div>

        <!-- Employee Details -->
        <div class="form-section">
            <div class="section-header">
                <i class="fa-solid fa-user-check"></i>
                Personal Details
            </div>

            <div class="row">
                <div class="col-half">
                    <label class="required-field">Full Name</label>
                    <input type="text" name="name" class="simple-input" placeholder="Enter full name" required>
                </div>

                <div class="col-half">
                    <label class="required-field">Gender</label>
                    <select name="gender" class="simple-input select2" required>
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="row">

                <div class="col-third">
                    <label>Religion</label>
                    <input type="text" name="religion" class="simple-input">
                </div>
                <div class="col-third">
                    <label>Blood Group</label>
                    <select name="blood_group" class="simple-input select2">
                        <option value="">Select Blood Group</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                </div>
                <div class="col-third">
                    <label>Date of Birth</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-birthday-cake"></i></span>
                        <input type="text" name="date_of_birth" class="form-control flatpickr-date"
                            placeholder="Select Date">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-half">
                    <label class="required-field">Mobile Number</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-phone"></i></span>
                        <input type="tel" name="mobile_number" class="simple-input" placeholder="Enter mobile number"
                            required>
                    </div>
                </div>

                <div class="col-half">
                    <label>Email Address</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-envelope"></i></span>
                        <input type="email" name="e_email" class="simple-input" placeholder="employee@example.com">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-half">
                    <label>Present Address</label>
                    <textarea name="present_address" class="simple-input" rows="2"
                        placeholder="Current residential address"></textarea>
                </div>

                <div class="col-half">
                    <label>Permanent Address</label>
                    <textarea name="permanent_address" class="simple-input" rows="2"
                        placeholder="Permanent residential address"></textarea>
                </div>
            </div>
        </div>

        <!-- Profile Picture -->
        <div class="form-section">
            <label class="section-label">Profile Picture</label>
            <div class="drop-zone" id="drop-zone">
                <div class="drop-content" id="drop-content">
                    <i class="fa-solid fa-cloud-arrow-up cloud-icon"></i>
                    <p>Drag and drop an image here or click to browse</p>
                    <small class="text-muted">Recommended: Square image, max 2MB</small>
                </div>
                <div class="preview-container" id="preview-container" style="display:none;">
                    <img id="preview-image" alt="Profile preview" />
                    <div class="filename-display" id="filename-display"></div>
                    <button type="button" class="remove-btn" id="remove-btn" title="Remove image">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <input type="file" name="profile_picture" id="file-input" accept="image/*" hidden>
            </div>
        </div>

        <!-- Login Details -->
        <div class="form-section">
            <div class="section-header">
                <i class="fa-solid fa-user-lock"></i>
                Login Credentials
            </div>

            <div class="row">
                <div class="col-half">
                    <label class="required-field">Username</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-regular fa-user"></i></span>
                        <input type="text" name="username" class="simple-input" placeholder="Choose a username"
                            required>
                        <div class="invalid-feedback username-feedback"></div>
                    </div>
                </div>
                <div class="col-quarter">
                    <label class="required-field">Password</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" name="password" id="password" class="simple-input"
                            placeholder="Enter password" required>
                    </div>
                </div>
                <div class="col-quarter">
                    <label class="required-field">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" name="retype_password" id="confirmPassword" class="simple-input"
                            placeholder="Confirm password" required>
                        <div class="invalid-feedback password-feedback"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Social Links -->
        <div class="form-section">
            <div class="section-header">
                <i class="fa-solid fa-globe"></i>
                Social Media Links
            </div>

            <div class="row">
                <div class="col-third">
                    <label>Facebook</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-brands fa-facebook-f"></i></span>
                        <input type="url" name="e_facebook_url" class="simple-input"
                            placeholder="https://facebook.com/username">
                    </div>
                </div>
                <div class="col-third">
                    <label>Twitter</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-brands fa-twitter"></i></span>
                        <input type="url" name="e_twitter_url" class="simple-input"
                            placeholder="https://twitter.com/username">
                    </div>
                </div>
                <div class="col-third">
                    <label>LinkedIn</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-brands fa-linkedin-in"></i></span>
                        <input type="url" name="e_linkedin_url" class="simple-input"
                            placeholder="https://linkedin.com/in/username">
                    </div>
                </div>
            </div>
        </div>

        <!-- Bank Details -->
        <div class="form-section">
            <div class="section-header">
                <i class="fas fa-university"></i>
                Bank Details
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="skipBankDetails" name="skipBankDetails" value="on">
                <label class="form-check-label" for="skipBankDetails">
                    Skip Bank Details
                </label>
            </div>

            <div id="bankDetailsSection">
                <div class="row">
                    <div class="col-third">
                        <label>Bank Name</label>
                        <input type="text" name="bank_name" class="simple-input">
                    </div>
                    <div class="col-third">
                        <label>Account Holder Name</label>
                        <input type="text" name="account_holder_name" class="simple-input"
                            placeholder="Full name as in bank account">
                    </div>
                    <div class="col-third">
                        <label>Branch Name</label>
                        <input type="text" name="bank_branch" class="simple-input" placeholder="Branch location">
                    </div>
                </div>

                <div class="row">
                    <div class="col-third">
                        <label>Bank Address</label>
                        <input type="text" name="bank_address" class="simple-input" placeholder="Full bank address">
                    </div>
                    <div class="col-third">
                        <label>IFSC Code</label>
                        <input type="text" name="ifsc_code" class="simple-input" placeholder="Bank identification code">
                    </div>
                    <div class="col-third">
                        <label>Account Number</label>
                        <input type="text" name="account_no" class="simple-input" placeholder="Bank account number">
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-section text-center">
            <button type="submit" class="save-btn">
                <i class="fas fa-save me-2"></i>Save
            </button>
        </div>
    </form>
</div>

<style>
    .select2-container--default .select2-selection--single {
        background-color: #fff;
        border: 1px solid #aaa;
        border-radius: 8px;
    }

    .select2-container .select2-selection--single {
        box-sizing: border-box;
        cursor: pointer;
        display: block;
        height: 42px;
        user-select: none;
        -webkit-user-select: none;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #444;
        line-height: 40px;
    }

    .select2-container .select2-selection--single .select2-selection__rendered {
        display: block;
        padding-left: 8px;
        padding-right: 20px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>