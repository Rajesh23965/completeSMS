                                                                                data-bank-name="<%= account.bank_name %>"
                                                                                data-holder-name="<%= account.account_holder_name %>"
                                                                                data-branch="<%= account.bank_branch %>"
                                                                                data-address="<%= account.bank_address %>"
                                                                                data-ifsc="<%= account.ifsc_code %>"
                                                                                data-account-no="<%= account.account_no %>"
                                                                                title="Edit">
