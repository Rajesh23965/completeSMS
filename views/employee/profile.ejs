                                                                            <i class="fas fa-edit"></i>
                                                                        </button>
                                                                        <button
                                                                            class="btn btn-sm btn-danger btn-delete-document"
                                                                            data-id="<%= doc.id %>"
                                                                            data-toggle="tooltip"
                                                                            title="Delete Document">
                                                                            <i class="fas fa-trash"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <tr id="noDocumentsRow">
                                                                        <td colspan="8"
                                                                            class="px-6 whitespace-nowrap text-sm text-danger text-center">
                                                                            No Information Available
                                                                        </td>
                                                                    </tr>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Include the document modal -->
                            <%- include('partials/document-modal') %>
                    </div>


                    <style>
                        .select2-container--default .select2-selection--single {
                            background-color: #fff;
                            border: 1px solid #aaa;
                            border-radius: 8px;
                        }

                        .select2-container .select2-selection--single {
                            box-sizing: border-box;
                            cursor: pointer;
                            display: block;
                            height: 42px;
                            user-select: none;
                            -webkit-user-select: none;
                        }

                        .select2-container--default .select2-selection--single .select2-selection__rendered {
                            color: #444;
                            line-height: 40px;
                        }

                        .select2-container .select2-selection--single .select2-selection__rendered {
                            display: block;
                            padding-left: 8px;
                            padding-right: 20px;
                            overflow: hidden;
                            text-overflow: ellipsis;
                            white-space: nowrap;
                        }
                    </style>

                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            const existingImageInput = document.getElementById("existing-image");
                            const previewContainer = document.getElementById("preview-container");
                            const previewImage = document.getElementById("preview-image");
                            const dropContent = document.getElementById("drop-content");
                            const removeBtn = document.getElementById("remove-btn");
                            const fileInput = document.getElementById("file-input");

                            const existingImageUrl = existingImageInput.value;

                            if (existingImageUrl) {
                                previewImage.src = existingImageUrl;
                                previewContainer.style.display = "block";
                                dropContent.style.display = "none";
                            }

                            // Remove existing image preview
                            removeBtn.addEventListener("click", function () {
                                previewImage.src = "";
                                previewContainer.style.display = "none";
                                dropContent.style.display = "flex";
                                fileInput.value = "";
                            });

                            $('.select2').select2();
                        });
                    </script>