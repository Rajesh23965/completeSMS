<!-- Add Document Modal -->
<!-- Single Document Modal for Add/Edit -->
<div class="modal fade" id="documentModal" tabindex="-1" aria-labelledby="documentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="documentModalLabel">
                    <i class="fas fa-folder-plus me-2"></i><span id="modalActionText">Add Document</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="documentForm" enctype="multipart/form-data">
                <input type="hidden" id="documentId" name="id">
                <div class="modal-body">
                    <div class="row">
                        <!-- Title -->
                        <div class="col-md-12 mb-3">
                            <label for="title" class="form-label required">Title </label>
                            <input type="text" class="form-control" id="title" name="title"
                                placeholder="Enter document title" required>
                        </div>

                        <!-- Category -->
                        <div class="col-md-6 mb-3">
                            <label for="category" class="form-label required">Category </label>
                            <select class="form-select" id="category" name="category" required>
                                <option value="">Select Category</option>
                                <option value="Resume File">Resume File</option>
                                <option value="Offer Letter">Offer Letter</option>
                                <option value="Joining Letter">Joining Letter</option>
                                <option value="Experience Certificate">Experience Certificate</option>
                                <option value="Resignation Letter">Resignation Letter</option>
                                <option value="ID Proof">ID Proof</option>
                                <option value="Address Proof">Address Proof</option>
                                <option value="Education Certificate">Education Certificate</option>
                                <option value="PAN Card">PAN Card</option>
                                <option value="Aadhaar Card">Aadhaar Card</option>
                                <option value="Passport">Passport</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <!-- Document Type -->
                        <div class="col-md-6 mb-3">
                            <label for="document_type" class="form-label">Document Type</label>
                            <select class="form-select" id="document_type" name="document_type">
                                <option value="">Select Type</option>
                                <option value="PDF">PDF</option>
                                <option value="Word">Word Document</option>
                                <option value="Excel">Excel</option>
                                <option value="Image">Image</option>
                                <option value="Text">Text File</option>
                                <option value="Video">Video</option>
                            </select>
                        </div>

                        <!-- Document File Upload -->
                        <div class="col-md-12 mb-3">
                            <label for="document_file" class="form-label">
                                Document File 
                                <span id="fileRequired" class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="file" class="form-control" id="document_file" name="document_file"
                                    accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.txt,.webp,.svg,.ico,.mp4,.mpeg,.avi,.mkv">
                                <label class="input-group-text" for="document_file">
                                    <i class="fas fa-upload"></i>
                                </label>
                            </div>
                            <div class="form-text text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                <span id="fileHelpText">
                                    Supported formats: PDF, Word, Excel, Images, Text, Videos
                                </span>
                            </div>

                            <!-- File Preview Area -->
                            <div id="filePreview" class="mt-2 d-none">
                                <div class="alert alert-light border p-2 d-flex align-items-center">
                                    <div class="me-3">
                                        <i class="fas fa-file fa-2x text-primary"></i>
                                    </div>
                                    <div>
                                        <strong id="fileName" class="d-block"></strong>
                                        <small id="fileSize" class="text-muted"></small>
                                        <div class="mt-1">
                                            <span id="fileTypeBadge" class="badge bg-info"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Current File Info (for edit mode) -->
                            <div id="currentFileInfo" class="mt-2 d-none">
                                <div class="alert alert-info p-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-file me-2"></i>
                                        Current file: <span id="currentFileName" class="fw-bold"></span>
                                    </div>
                                    <a href="#" id="downloadCurrentFile" class="btn btn-sm btn-success">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="col-md-12 mb-3">
                            <label for="remarks" class="form-label">Remarks</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="3"
                                placeholder="Optional remarks about the document"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" id="saveDocumentBtn">
                        <span id="saveBtnText">
                            <i class="fas fa-save me-1"></i>Save Document
                        </span>
                        <span id="saveBtnLoader" class="spinner-border spinner-border-sm d-none ms-1"
                            role="status"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Document Modal -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const employeeId = '<%= employee.id %>';
    const documentForm = document.getElementById('documentForm');
    const documentModal = new bootstrap.Modal(document.getElementById('documentModal'));
    const modalActionText = document.getElementById('modalActionText');
    const fileRequired = document.getElementById('fileRequired');
    const fileHelpText = document.getElementById('fileHelpText');
    const currentFileInfo = document.getElementById('currentFileInfo');
    const currentFileName = document.getElementById('currentFileName');
    const downloadCurrentFile = document.getElementById('downloadCurrentFile');
    const documentFileInput = document.getElementById('document_file');
    
    // Reset modal when hidden
    document.getElementById('documentModal').addEventListener('hidden.bs.modal', function () {
        resetModal();
    });

    // Add Document Button Click
    document.getElementById('addDocumentBtn').addEventListener('click', function() {
        resetModal();
        modalActionText.textContent = 'Add Document';
        fileRequired.style.display = 'inline';
        fileHelpText.textContent = 'Supported formats: PDF, Word, Excel, Images, Text, Videos';
        currentFileInfo.classList.add('d-none');
        document.getElementById('saveBtnText').innerHTML = '<i class="fas fa-save me-1"></i>Save Document';
        documentModal.show();
    });

    // Edit Document Button Click
    document.querySelectorAll('.btn-edit-document').forEach(button => {
        button.addEventListener('click', function () {
            const documentId = this.getAttribute('data-id');
            loadDocumentForEdit(documentId);
        });
    });

    // File preview handler
    documentFileInput.addEventListener('change', function () {
        const file = this.files[0];
        if (file) {
            // Show file preview
            showFilePreview(file);
        } else {
            document.getElementById('filePreview').classList.add('d-none');
        }
    });

    // Form submission handler
    documentForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        
        const documentId = document.getElementById('documentId').value;
        const isEditMode = !!documentId;
        
        // Validate form
        if (!validateForm(isEditMode)) {
            return;
        }

        const formData = new FormData(this);
        formData.append('employee_id', employeeId);

        // Show loading state
        showLoading(true);

        try {
            const url = isEditMode 
                ? `/employee/${employeeId}/documents/${documentId}`
                : `/employee/${employeeId}/documents`;
            
            const method = isEditMode ? 'PUT' : 'POST';
            
            const response = await fetch(url, {
                method: method,
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json();
            
            if (data.success) {
                showNotification(
                    isEditMode ? 'Document updated successfully!' : 'Document added successfully!',
                    'success'
                );
                
                documentModal.hide();
                
                // Reload page after delay
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            } else {
                showNotification(data.message || 'Operation failed', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification('An error occurred. Please try again.', 'error');
        } finally {
            showLoading(false);
        }
    });

    // Delete document handler
    document.querySelectorAll('.btn-delete-document').forEach(button => {
        button.addEventListener('click', function () {
            const documentId = this.getAttribute('data-id');
            if (confirm('Are you sure you want to delete this document?')) {
                fetch(`/employee/${employeeId}/documents/${documentId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('Document deleted successfully!', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showNotification(data.message || 'Failed to delete document', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Failed to delete document', 'error');
                });
            }
        });
    });

    // Helper Functions
    async function loadDocumentForEdit(documentId) {
        try {
            const response = await fetch(`/employee/documents/${documentId}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.success && data.data) {
                const doc = data.data;
                
                // Set modal to edit mode
                resetModal();
                modalActionText.textContent = 'Edit Document';
                fileRequired.style.display = 'none';
                fileHelpText.textContent = 'Leave empty to keep existing file. Max size: 50MB';
                document.getElementById('saveBtnText').innerHTML = '<i class="fas fa-save me-1"></i>Update Document';
                
                // Populate form fields
                document.getElementById('documentId').value = doc.id;
                document.getElementById('title').value = doc.title || '';
                document.getElementById('category').value = doc.category || '';
                document.getElementById('document_type').value = doc.document_type || '';
                document.getElementById('remarks').value = doc.remarks || '';
                
                // Show current file info
                if (doc.document_file) {
                    currentFileName.textContent = doc.document_file;
                    currentFileInfo.classList.remove('d-none');
                    
                    // Set download link for current file
                    downloadCurrentFile.href = `/employee/${employeeId}/documents/${doc.id}/download`;
                }
                
                // Show modal
                documentModal.show();
            } else {
                showNotification('Failed to load document data', 'error');
            }
        } catch (error) {
            console.error('Error loading document:', error);
            showNotification('Failed to load document', 'error');
        }
    }

    function resetModal() {
        documentForm.reset();
        document.getElementById('documentId').value = '';
        document.getElementById('filePreview').classList.add('d-none');
        currentFileInfo.classList.add('d-none');
        downloadCurrentFile.href = '#';
        
        // Clear validation messages
        const errorElements = document.querySelectorAll('.is-invalid, .invalid-feedback');
        errorElements.forEach(el => {
            el.classList.remove('is-invalid');
            el.classList.remove('invalid-feedback');
            if (el.tagName === 'DIV') {
                el.remove();
            }
        });
    }

    function validateForm(isEditMode) {
        let isValid = true;
        
        // Clear previous errors
        document.querySelectorAll('.is-invalid').forEach(el => {
            el.classList.remove('is-invalid');
        });
        document.querySelectorAll('.invalid-feedback').forEach(el => {
            el.remove();
        });
        
        // Validate title
        const title = document.getElementById('title').value.trim();
        if (!title) {
            showFieldError('title', 'Title is required');
            isValid = false;
        }
        
        // Validate category
        const category = document.getElementById('category').value;
        if (!category) {
            showFieldError('category', 'Category is required');
            isValid = false;
        }
        
        // Validate file (only for add mode)
        if (!isEditMode && !documentFileInput.files[0]) {
            showFieldError('document_file', 'Document file is required');
            isValid = false;
        }
        
        // Validate file type if file is selected
        if (documentFileInput.files[0]) {
            const file = documentFileInput.files[0];
            const allowedTypes = [
                'application/pdf',
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'application/vnd.ms-excel',
                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                'image/jpeg',
                'image/png',
                'image/gif',
                'image/webp',
                'image/svg+xml',
                'text/plain',
                'video/mp4',
                'video/mpeg',
                'video/x-msvideo',
                'video/x-matroska'
            ];
            
            if (!allowedTypes.includes(file.type) && !file.name.match(/\.(pdf|doc|docx|xls|xlsx|jpg|jpeg|png|gif|webp|svg|txt|mp4|mpeg|avi|mkv)$/i)) {
                showFieldError('document_file', 'File type not supported');
                isValid = false;
            }
            
            // Check file size (50MB limit)
            if (file.size > 50 * 1024 * 1024) {
                showFieldError('document_file', 'File size exceeds 50MB limit');
                isValid = false;
            }
        }
        
        return isValid;
    }

    function showFieldError(fieldId, message) {
        const field = document.getElementById(fieldId);
        const formGroup = field.closest('.mb-3') || field.closest('.col-md-12') || field.closest('.col-md-6');
        
        field.classList.add('is-invalid');
        
        const errorDiv = document.createElement('div');
        errorDiv.className = 'invalid-feedback';
        errorDiv.textContent = message;
        
        formGroup.appendChild(errorDiv);
    }

    function showFilePreview(file) {
        const filePreview = document.getElementById('filePreview');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        const fileTypeBadge = document.getElementById('fileTypeBadge');
        
        fileName.textContent = file.name;
        
        // Format file size
        const fileSizeBytes = file.size;
        let sizeText = '';
        if (fileSizeBytes < 1024) {
            sizeText = fileSizeBytes + ' bytes';
        } else if (fileSizeBytes < 1024 * 1024) {
            sizeText = (fileSizeBytes / 1024).toFixed(2) + ' KB';
        } else {
            sizeText = (fileSizeBytes / (1024 * 1024)).toFixed(2) + ' MB';
        }
        fileSize.textContent = sizeText;
        
        // Determine file type
        const fileExtension = file.name.split('.').pop().toLowerCase();
        let typeText = '';
        
        if (fileExtension === 'pdf') {
            typeText = 'PDF';
        } else if (['doc', 'docx'].includes(fileExtension)) {
            typeText = 'Word';
        } else if (['xls', 'xlsx'].includes(fileExtension)) {
            typeText = 'Excel';
        } else if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(fileExtension)) {
            typeText = 'Image';
        } else if (fileExtension === 'txt') {
            typeText = 'Text';
        } else if (['mp4', 'mpeg', 'avi', 'mkv'].includes(fileExtension)) {
            typeText = 'Video';
        } else {
            typeText = fileExtension.toUpperCase();
        }
        
        fileTypeBadge.textContent = typeText;
        filePreview.classList.remove('d-none');
        
        // Auto-select document type if empty
        const documentTypeSelect = document.getElementById('document_type');
        if (!documentTypeSelect.value) {
            if (file.type === 'application/pdf') {
                documentTypeSelect.value = 'PDF';
            } else if (file.type.includes('word') || ['doc', 'docx'].includes(fileExtension)) {
                documentTypeSelect.value = 'Word';
            } else if (file.type.includes('excel') || file.type.includes('spreadsheet') || ['xls', 'xlsx'].includes(fileExtension)) {
                documentTypeSelect.value = 'Excel';
            } else if (file.type.includes('image')) {
                documentTypeSelect.value = 'Image';
            } else if (file.type.includes('text') || fileExtension === 'txt') {
                documentTypeSelect.value = 'Text';
            } else if (file.type.includes('video')) {
                documentTypeSelect.value = 'Video';
            }
        }
    }

    function showLoading(show) {
        const saveBtnText = document.getElementById('saveBtnText');
        const saveBtnLoader = document.getElementById('saveBtnLoader');
        const saveDocumentBtn = document.getElementById('saveDocumentBtn');
        
        if (show) {
            const isEditMode = !!document.getElementById('documentId').value;
            saveBtnText.innerHTML = `<i class="fas fa-spinner fa-spin me-1"></i>${isEditMode ? 'Updating...' : 'Saving...'}`;
            saveBtnLoader.classList.remove('d-none');
            saveDocumentBtn.disabled = true;
        } else {
            const isEditMode = !!document.getElementById('documentId').value;
            saveBtnText.innerHTML = `<i class="fas fa-save me-1"></i>${isEditMode ? 'Update Document' : 'Save Document'}`;
            saveBtnLoader.classList.add('d-none');
            saveDocumentBtn.disabled = false;
        }
    }

    function showNotification(message, type = 'info') {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed`;
        notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        notification.innerHTML = `
            <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        document.body.appendChild(notification);

        // Auto remove after 3 seconds
        setTimeout(() => {
            if (notification.parentNode) {
                notification.parentNode.removeChild(notification);
            }
        }, 3000);
    }
});
</script>