<!-- views/parents/view.ejs -->
<header class="panel-heading">
    <h4 class="panel-title"><i class="fas fa-users"></i> Parent List</h4>
</header>

<div class="main-form">

    <!-- Export Controls -->
    <div class="row mb-3" style="margin-top:-20px;">
        <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        width:100%;
        gap:10px;
    ">
            <div style="display:flex; align-items:center; gap:6px;">

                <a href="#" onclick="copyTable()" title="Copy" style="
                width:36px;height:36px;
                display:flex;align-items:center;justify-content:center;
                border:1px solid #e5e7eb;
                background:#fff;
                border-radius:4px;
                color:#374151;
               ">
                    <i class="far fa-copy"></i>
                </a>

                <a href="#" onclick="exportTo('excel')" title="Excel" style="
                width:36px;height:36px;
                display:flex;align-items:center;justify-content:center;
                border:1px solid #e5e7eb;
                background:#fff;
                border-radius:4px;
                color:#1d6f42;
               ">
                    <i class="fa fa-file-excel"></i>
                </a>

                <a href="#" onclick="exportTo('csv')" title="CSV" style="
                width:36px;height:36px;
                display:flex;align-items:center;justify-content:center;
                border:1px solid #e5e7eb;
                background:#fff;
                border-radius:4px;
                color:#374151;
               ">
                    <i class="fa fa-file-alt"></i>
                </a>

                <a href="#" onclick="exportTo('pdf')" title="PDF" style="
                width:36px;height:36px;
                display:flex;align-items:center;justify-content:center;
                border:1px solid #e5e7eb;
                background:#fff;
                border-radius:4px;
                color:#b91c1c;
               ">
                    <i class="fa fa-file-pdf"></i>
                </a>
                <a href="#" onclick="window.print()" title="Print" style="
                width:36px;height:36px;
                display:flex;align-items:center;justify-content:center;
                border:1px solid #e5e7eb;
                background:#fff;
                border-radius:4px;
                color:#374151;
               ">
                    <i class="fa fa-print"></i>
                </a>

                <div class="btn-group position-relative">

                    <a href="#" id="colvisBtn" title="Columns" style="
                    width:36px;height:36px;
                    display:flex;align-items:center;justify-content:center;
                    border:1px solid #e5e7eb;
                    background:#fff;
                    border-radius:4px;
                    color:#374151;
                   ">
                        <i class="fas fa-columns"></i>
                    </a>

                    <div class="colvis-dropdown shadow" id="colvisDropdown">
                        <ul>
                            <li data-col="0">SN</li>
                            <li data-col="1">Guardian Name</li>
                            <li data-col="2">Occupation</li>
                            <li data-col="3">Mobile No</li>
                            <li data-col="4">Email</li>
                            <li data-col="5">Action</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div id="DataTables_Table_0_filter" class="dataTables_filter">
                    <label>
                        <input type="search" class="form-control pull-right" placeholder="Search..."
                            aria-controls="DataTables_Table_0" onkeyup="searchParents()" value="<%= search %>">
                    </label>
                </div>
            </div>

        </div>

    </div>

    <!-- Main Parent List Table -->
    <div id="print-area">
        <div class="table-responsive">

            <table class="table table-bordered table-hover  min-w-full divide-y divide-gray-200" id="parentsTable">
                <thead class="table-custom">
                    <tr>
                        <th onclick="sortTable('id')" data-col="id"
                            class="sortable px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <span>SN</span>
                            <span class="sort-icons">
                                <i class="fas fa-sort"></i>
                            </span>
                        </th>
                        <th onclick="sortTable('name')"
                            class="px-6  text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Guardian Name
                            <span class="sort-icons">
                                <i class="fas fa-sort"></i>
                            </span>
                        </th>
                        <th onclick="sortTable('occupation')"
                            class="px-6  text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Occupation
                            <span class="sort-icons">
                                <i class="fas fa-sort"></i>
                            </span>
                        </th>
                        <th onclick="sortTable('mobile_no')"
                            class="px-6  text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Mobile No
                            <span class="sort-icons">
                                <i class="fas fa-sort"></i>
                            </span>
                        </th>
                        <th onclick="sortTable('email')"
                            class="px-6  text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Email
                            <span class="sort-icons">
                                <i class="fas fa-sort"></i>
                            </span>
                        </th>
                        <th class="px-6  text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Action
                        </th>
                    </tr>
                </thead>

                <tbody id="parentsTableBody">
                    <% if (parents && parents.length> 0) { %>
                        <% parents.forEach((parent, index)=> { %>
                            <tr>
                                <td class="px-6  whitespace-nowrap text-sm text-gray-900">
                                    <%= (pagination.page - 1) * pagination.limit + index + 1 %>
                                </td>
                                <td class="px-6  whitespace-nowrap text-sm text-gray-900">
                                    <%= parent.name %>
                                </td>
                                <td class="px-6  whitespace-nowrap text-sm text-gray-900">
                                    <%= parent.occupation %>
                                </td>
                                <td class="px-6  whitespace-nowrap text-sm text-gray-900">
                                    <%= parent.mobile_no %>
                                </td>
                                <td class="px-6  whitespace-nowrap text-sm text-gray-900">
                                    <%= parent.email %>
                                </td>

                                <td class="px-6">
                                    <div class="action-buttons">
                                        <a href="/parents/profile/<%= parent.id %>"
                                            class="btn btn-sm btn-primary btn-edit" title="Profile">
                                            <i class="far fa-arrow-alt-circle-right"></i>
                                        </a>

                                        <button class="btn btn-sm btn-danger btn-delete" data-id="<%= parent.id %>">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7"
                                            class="px-6  whitespace-nowrap text-sm text-gray-500 text-center">
                                            No parents found.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>

            </table>
        </div>
    </div>

    <!-- Pagination -->
    <div class="pagination-controls d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted">
            Showing <%= parents.length %> of <%= pagination.total %> parents
        </div>
        <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center">

            <!-- Previous Button -->
            <a href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>"
                class="btn btn-sm btn-outline-primary <%= pagination.page <= 1 ? 'disabled' : '' %>">
                <i class="fas fa-chevron-left"></i>
            </a>

            <!-- Page Info -->
            <span class="btn btn-sm btn-light">
                Page <%= pagination.page %> of <%= pagination.totalPages %>
            </span>

            <!-- Next Button -->
            <a href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>"
                class="btn btn-sm btn-outline-primary <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>

</div>

<script>

    // Export functions
    function exportTo(format) {
        window.location.href = `/parents/export?format=${format}`;
    }

    async function copyTable() {
        try {
            const response = await fetch('/parents/export?format=copy');
            const result = await response.json();

            if (result.success) {
                // Create a temporary textarea for copying
                const textarea = document.createElement('textarea');
                textarea.value = result.data;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);


            }
        } catch (error) {
            console.error('Copy failed:', error);
            alert('Failed to copy table');
        }
    }

    const PAGE_LIMIT = `<%= pagination.limit %>`;

    // Search function
    function searchParents() {
        const searchTerm = document.querySelector('input[type="search"]').value;
        window.location.href =
            `?page=1&limit=${PAGE_LIMIT}&search=${encodeURIComponent(searchTerm)}`;
    }

    // Change rows per page
    function changeRowsPerPage(limit) {
        window.location.href = `? page = 1 & limit=${limit} `;
    }

    // Print function
    window.printTable = function () {
        window.print();
    }
    function printTable() {
        window.print();
    }

    // Event listeners for edit and delete buttons
    document.addEventListener('DOMContentLoaded', function () {

        document.querySelectorAll('.btn-edit').forEach(button => {
            button.addEventListener('click', function () {
                const parentId = this.getAttribute('data-id');
                window.location.href = `/ parents / edit / ${parentId} `;
            });
        });

        // Delete buttons
        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function () {
                const parentId = this.getAttribute('data-id');
                if (confirm('Are you sure you want to delete this parent?')) {
                    fetch(`/ parents / ${parentId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                alert('Parent deleted successfully!');
                                window.location.reload();
                            } else {
                                alert('Failed to delete parent: ' + data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Failed to delete parent');
                        });
                }
            });
        });
    });
</script>

<!-- Print Styles -->
<style media="print">
    @media print {

        body * {
            visibility: hidden;
        }

        #print-area,
        #print-area * {
            visibility: visible;
        }

        #print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .print-title {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 6px;
            font-size: 12px;
        }

        .action-buttons {
            display: none !important;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('colvisBtn');
        const dropdown = document.getElementById('colvisDropdown');
        const table = document.getElementById('parentsTable');

        // Toggle dropdown
        btn.addEventListener('click', e => {
            e.preventDefault();
            dropdown.style.display =
                dropdown.style.display === 'block' ? 'none' : 'block';
        });

        // Column toggle
        dropdown.querySelectorAll('li').forEach(item => {
            const colIndex = parseInt(item.dataset.col);

            item.addEventListener('click', () => {
                const isHidden = item.classList.toggle('hidden-col');

                toggleColumn(table, colIndex, !isHidden);
                saveColumnState(colIndex, !isHidden);
            });
        });

        // Load saved state
        loadColumnState(table, dropdown);

        document.addEventListener('click', e => {
            if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    });

    function toggleColumn(table, index, show) {
        table.querySelectorAll('tr').forEach(row => {
            if (row.children[index]) {
                row.children[index].style.display = show ? '' : 'none';
            }
        });
    }

    /* -------- Persist column state -------- */
    function saveColumnState(index, visible) {
        const state = JSON.parse(localStorage.getItem('parentCols') || '{}');
        state[index] = visible;
        localStorage.setItem('parentCols', JSON.stringify(state));
    }

    function loadColumnState(table, dropdown) {
        const state = JSON.parse(localStorage.getItem('parentCols') || '{}');

        Object.keys(state).forEach(index => {
            toggleColumn(table, index, state[index]);

            if (!state[index]) {
                dropdown.querySelector(`li[data-col="${index}"]`)
                    ?.classList.add('hidden-col');
            }
        });
    }
</script>



<script>
    let currentPage = 1;
    let currentSortBy = 'id';
    let currentSortDir = 'DESC';
    const limit = `<%= pagination.limit %>`;

    async function fetchParents(page = 1) {
        const search = document.querySelector('input[type="search"]').value;

        const res = await fetch(
            `/parents/ajax/list?page=${page}` +
            `&limit=${limit}` +
            `&search=${encodeURIComponent(search)}` +
            `&sortBy=${currentSortBy}` +
            `&sortDir=${currentSortDir}`
        );

        const json = await res.json();
        if (!json.success) return;

        currentPage = json.pagination.page;
        renderTable(json.data, json.pagination);
    }

    function sortTable(column) {
        if (currentSortBy === column) {
            currentSortDir = currentSortDir === 'ASC' ? 'DESC' : 'ASC';
        } else {
            currentSortBy = column;
            currentSortDir = 'ASC';
        }
        fetchParents(1);
    }
</script>



<script>
    function renderTable(data, pagination) {
        const tbody = document.getElementById('parentsTableBody');
        tbody.innerHTML = '';

        if (!data.length) {
            tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center text-muted">
                    No parents found.
                </td>
            </tr>`;
            return;
        }

        data.forEach((parent, index) => {
            const sn = (pagination.page - 1) * pagination.limit + index + 1;

            tbody.insertAdjacentHTML('beforeend', `
            <tr>
                <td>${parent.id}</td>
                <td>${parent.name || ''}</td>
                <td>${parent.occupation || ''}</td>
                <td>${parent.mobile_no || ''}</td>
                <td>${parent.email || ''}</td>
                <td>
                    <button class="btn btn-sm btn-primary btn-edit" data-id="${parent.id}">
                        <i class="far fa-arrow-alt-circle-right"></i>
                    </button>
                    <button class="btn btn-sm btn-danger btn-delete" data-id="${parent.id}">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `);
        });
    }
</script>